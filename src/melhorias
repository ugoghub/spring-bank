AccountFactory

@Transactional(readOnly = true) em casos de uso que apenas consultam dados LEITURAA
@Transactional em casos de uso que alteram dados ESCRITA

public record GetClientDataOutput(
        PersonName name,
        CPF cpf,
        Email email
) {

    public static GetClientDataOutput from(Client client) {
        return new GetClientDataOutput(
                client.getName(),
                client.getCpf(),
                client.getEmail()
        );
    }
}

